{
    "name": "likeuntomurphy/graphql-bundle",
    "description": "A drop-in GraphQL server for Symfony",
    "type": "symfony-bundle",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Likeuntomurphy\\GraphQL\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Likeuntomurphy\\GraphQL\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.5",
        "phpstan/phpdoc-parser": "^2.3",
        "symfony/config": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/expression-language": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/property-access": "^8.0",
        "symfony/serializer": "^8.0",
        "symfony/string": "^8.0",
        "symfony/type-info": "^8.0",
        "symfony/validator": "^8.0",
        "webonyx/graphql-php": "^15.30"
    },
    "suggest": {
        "doctrine/mongodb-odm": "Required to use the CursorPaginatedRepository"
    },
    "require-dev": {
        "doctrine/mongodb-odm": "^2.16",
        "friendsofphp/php-cs-fixer": "^3.94",
        "matthiasnoback/symfony-dependency-injection-test": "^6.2",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13.0"
    },
    "config": {
        "sort-packages": true
    }
}
